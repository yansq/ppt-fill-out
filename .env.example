# System database. MySQL is external to the default Compose stack.
# macOS/Windows containers can use host.docker.internal; Linux uses the
# host-gateway mapping declared in docker/docker-compose.yml.
DATABASE_URL="mysql://report_user:change-me@host.docker.internal:3306/report_platform"

# Auth.js
AUTH_SECRET="replace-with-at-least-32-random-bytes"
# Browser-facing URL; internal HTTP is supported where HTTPS is unavailable.
AUTH_URL="http://localhost:3000"
NEXT_TELEMETRY_DISABLED="1"
# Compose binds only loopback by default. Set to a specific intranet IP if the reverse proxy is on another host.
WEB_BIND_ADDRESS="127.0.0.1"
WEB_PORT="3000"

# Internal PPT service and shared storage
PPT_SERVICE_URL="http://ppt-service:8080"
PPT_SERVICE_API_KEY="replace-with-an-internal-service-key"
STORAGE_ROOT="/data"
MAX_UPLOAD_SIZE_MB="50"

# Auth.js Credentials users are provisioned with the seed:auth command.
# Set AUTH_SEED_USERNAME, AUTH_SEED_PASSWORD and AUTH_SEED_ROLE only for that command.

# Application-layer encryption for data-source passwords.
# Supply a base64-encoded 32-byte key and rotate via ENCRYPTION_KEY_VERSION.
ENCRYPTION_KEY="replace-with-a-base64-encoded-32-byte-key"
ENCRYPTION_KEY_VERSION="v1"

# OpenAI-compatible AI provider (used from P7 onward)
AI_PROVIDER="openai-compatible"
AI_BASE_URL="http://internal-ai.example.local/v1"
AI_API_KEY="replace-me"
AI_MODEL="replace-me"

# PPT service runtime
LIBREOFFICE_EXECUTABLE="soffice"
JAVA_OPTS="-XX:MaxRAMPercentage=75.0"
