# MySQL account with CREATE DATABASE and import privileges; not used by the app.
MYSQL_HOST=192.0.2.10
MYSQL_PORT=3306
MYSQL_USER=import_admin
MYSQL_PASSWORD=CHANGE_ME

# Credential used by the imported demo metric source at runtime.
# Grant this account SELECT, INSERT, UPDATE on report_metrics_demo.
METRIC_DB_HOST=192.0.2.10
METRIC_DB_PORT=3306
METRIC_DB_USER=report_metric
METRIC_DB_PASSWORD=CHANGE_ME
